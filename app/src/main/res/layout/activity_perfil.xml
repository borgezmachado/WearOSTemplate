<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060911">

    <!-- Imagem de Fundo Suave -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.20"
        android:scaleType="centerCrop"
        android:src="@drawable/tela5" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/containerPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <!-- FOTO DE PERFIL / AVATAR COM CIRCULO NEON -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:id="@+id/imgFotoPerfil"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_neon_ring"
                    android:padding="3dp"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#00E5FF" />
            </FrameLayout>

            <!-- NOME DO ATLETA (Glow aplicado no Kotlin) -->
            <TextView
                android:id="@+id/txtNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.08"
                android:text="ATLETA XLR8"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- PAINEL DE ESTATÍSTICAS (CARD HUD ESTILIZADO) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@android:drawable/toast_frame"
                android:backgroundTint="#1500E5FF"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- DISTÂNCIA TOTAL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="DISTÂNCIA TOTAL"
                    android:textColor="#80FFFFFF"
                    android:textSize="7sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDistanciaTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:text="0.0 KM"
                    android:textColor="#00E5FF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- TEMPO TOTAL E PACE MÉDIO (LADO A LADO) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- TEMPO TOTAL -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TEMPO"
                            android:textColor="#80FFFFFF"
                            android:textSize="7sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtTempoTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00m 00s"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- DIVISOR VERTICAL -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_vertical"
                        android:background="#3000E5FF" />

                    <!-- PACE MÉDIO -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PACE MÉDIO"
                            android:textColor="#80FFFFFF"
                            android:textSize="7sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtPaceMedio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--:-- /KM"
                            android:textColor="#FF0055"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- BOTÃO VOLTAR -->
            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_neon_ring"
                android:contentDescription="Voltar"
                android:elevation="4dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#060911" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>