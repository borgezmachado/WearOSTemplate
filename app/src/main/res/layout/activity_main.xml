<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060911">

    <!-- Fundo Esportivo com Opacidade Ajustada -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25"
        android:scaleType="centerCrop"
        android:src="@drawable/tela5" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/containerTreino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <!-- TÍTULO XLR8 -->
            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="XLR8"
                android:textColor="#00E5FF"
                android:textSize="18sp"
                android:textStyle="bold|italic" />

            <!-- SUBTÍTULO / STATUS -->
            <TextView
                android:id="@+id/txtSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="4dp"
                android:letterSpacing="0.08"
                android:text="READY TO RUN"
                android:textColor="#FF0055"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- CRONÔMETRO PRINCIPAL NEON -->
            <TextView
                android:id="@+id/txtTempo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- PAINEL COMPLETO DE MÉTRICAS (KM, PACE, KCAL) -->
            <LinearLayout
                android:id="@+id/panelStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:background="@android:drawable/toast_frame"
                android:backgroundTint="#1500E5FF"
                android:orientation="horizontal"
                android:padding="8dp">

                <!-- DISTÂNCIA -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KM"
                        android:textColor="#00E5FF"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDistancia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="0.00" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:background="#3000E5FF" />

                <!-- PACE / RITMO -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PACE"
                        android:textColor="#00E5FF"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtRitmo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="--:--" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:background="#3000E5FF" />

                <!-- KCAL -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KCAL"
                        android:textColor="#00E5FF"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCalorias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="0" />
                </LinearLayout>
            </LinearLayout>

            <!-- PAINEL DE BOTÕES DE AÇÃO DESTACADOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- BOTÃO INICIAR -->
                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#00E5FF"
                    android:elevation="4dp"
                    android:letterSpacing="0.05"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="0dp"
                    android:text="INICIAR"
                    android:textColor="#060911"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- BOTÃO PARAR -->
                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FF0055"
                    android:elevation="4dp"
                    android:letterSpacing="0.05"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="0dp"
                    android:text="PARAR"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- BOTÃO NAVEGAÇÃO PERFIL -->
            <Button
                android:id="@+id/btnPerfil"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:backgroundTint="#1500E5FF"
                android:letterSpacing="0.08"
                android:paddingHorizontal="0dp"
                android:paddingVertical="0dp"
                android:text="VER PERFIL"
                android:textColor="#00E5FF"
                android:textSize="9sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>